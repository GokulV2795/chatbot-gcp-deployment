# Copy to .env and fill in real values. Never commit the real .env file.

# --- OpenRouter ---
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_MODEL=anthropic/claude-haiku-4.5
OPENROUTER_SITE_URL=http://localhost
OPENROUTER_SITE_NAME=My OpenRouter Chatbot

# --- Backend ---
# Shared secret the frontend must send as `Authorization: Bearer <value>`.
# Leave blank to disable auth (fine for local dev, not recommended once the VM is public).
APP_SHARED_SECRET=
CORS_ORIGINS=http://localhost:3000

# --- Frontend ---
# Same value as APP_SHARED_SECRET above; baked in at build time for the browser to send.
NEXT_PUBLIC_APP_SHARED_SECRET=
# In production behind the bundled nginx reverse proxy, leave this as /api (same-origin).
NEXT_PUBLIC_API_BASE_URL=/api

# --- Deployment (used by infra scripts / GitHub Actions, not by the app itself) ---
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
GCP_ZONE=us-central1-a
ARTIFACT_REGISTRY_REPO=chatbot
VM_NAME=chatbot-vm
