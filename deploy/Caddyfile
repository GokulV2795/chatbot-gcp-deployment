{$DOMAIN} {
	# DOMAIN is resolved by docker-compose.yml (defaults to ":80" — plain
	# HTTP, no auto-HTTPS attempt — when unset). Set DOMAIN in .env once you
	# have a real hostname pointed at this VM to get automatic Let's Encrypt
	# HTTPS instead.
	encode gzip

	handle /api/* {
		uri strip_prefix /api
		reverse_proxy backend:8000
	}

	handle {
		reverse_proxy frontend:3000
	}
}
